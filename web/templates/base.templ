package templates

// Base is the HTML document shell. tokenBase is the per-run URL prefix
// ("/<token>/") set as <base href> so every relative asset link resolves under
// the token path the loopback server gates on.
templ Base(title, tokenBase string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<base href={ tokenBase }/>
			<link rel="stylesheet" href="assets/app.css"/>
			<script src="assets/htmx.min.js" defer></script>
			<script src="assets/alpine.min.js" defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

// Shell is the top-level app frame. It is a placeholder until the session
// surfaces (list, timeline, artifacts) land in later beads; for now it confirms
// the shell, the loopback server, and the embedded htmx/Alpine/templ stack.
templ Shell(tokenBase string) {
	@Base("tend-ui", tokenBase) {
		<header class="titlebar">
			<span class="glyph">t</span>
			<span class="brand"><b>tend</b><span class="dim">-ui</span></span>
			<span class="mono sub">session console</span>
			<span class="conn"><span class="dot"></span> shell up</span>
		</header>
		<main class="body">
			<div class="placeholder">
				<div class="ph-title">tend-ui</div>
				<p class="mono">loopback server + embedded htmx · Alpine · templ</p>
				<p class="dim">
					Next: the daemon client, the SSE event stream, and the
					session timeline with inline artifacts.
				</p>
			</div>
		</main>
	}
}
