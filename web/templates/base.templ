package templates

import (
	"github.com/dusto/tend/api"

	"github.com/dusto/tend-ui/internal/session"
)

// Base is the HTML document shell. tokenBase is the per-run URL prefix
// ("/<token>/") set as <base href> so every relative asset link resolves under
// the token path the loopback server gates on.
templ Base(title, tokenBase string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<base href={ tokenBase }/>
			<link rel="stylesheet" href="assets/app.css"/>
			<script src="assets/htmx.min.js" defer></script>
			<script src="assets/htmx-ext-sse.min.js" defer></script>
			<script src="assets/alpine.min.js" defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

// Shell is the top-level app frame: a session rail (pick which session to
// follow) beside the focused session's header and live timeline. Inline
// artifacts land in a later bead; the raw workspace feed is still served at
// /events.
templ Shell(tokenBase string, sessions []api.SessionInfo, currentID api.SessionID, header SessionHeaderData, tools []session.ToolRef) {
	@Base("tend-ui", tokenBase) {
		<header class="titlebar">
			<span class="glyph">t</span>
			<span class="brand"><b>tend</b><span class="dim">-ui</span></span>
			<span class="mono sub">session console</span>
			<span class="conn"><span class="dot"></span> connected</span>
		</header>
		<div class="body-split">
			<aside class="rail">
				@SessionRail(sessions, currentID)
			</aside>
			<main class="body">
				@SessionHeader(header.Session, header.Usage, header.Found)
				<div class="timeline-pane" x-data="{ filter: 'all' }" :class="'filter-' + filter">
					<div class="tl-filter">
						<button type="button" :class="{ on: filter === 'all' }" @click="filter = 'all'">All</button>
						<button type="button" :class="{ on: filter === 'tool' }" @click="filter = 'tool'">Tool calls</button>
						<button type="button" :class="{ on: filter === 'edit' }" @click="filter = 'edit'">Edits</button>
					</div>
					<div class="log-wrap" hx-ext="sse" sse-connect="timeline">
						@TimelinePanel()
					</div>
				</div>
			</main>
			<aside class="rail jump">
				@JumpIndex(tools)
			</aside>
		</div>
	}
}

// TimelinePanel is the SSE-connected timeline container. It is also the swap
// target when a session is picked (/select returns a fresh, empty panel that
// reconnects the SSE stream for the newly-selected session).
templ TimelinePanel() {
	<div id="timeline" class="timeline" sse-swap="item" hx-swap="beforeend scroll:bottom">
		<div class="tl muted">
			<div class="tl-gutter"><span class="tl-node"></span></div>
			<div class="tl-main"><div class="tl-body dim">waiting for a session…</div></div>
		</div>
	</div>
}

// EventLine renders one workspace event as an SSE-swapped log row.
templ EventLine(ev api.Event) {
	<div class="ev">
		<span class="ev-time mono">{ evTime(ev) }</span>
		<span class="ev-type">{ ev.Type }</span>
		if evRoot(ev) != "" {
			<span class="ev-wt mono">{ evRoot(ev) }</span>
		}
	</div>
}
