package templates

import "github.com/dusto/tend/api"

// Base is the HTML document shell. tokenBase is the per-run URL prefix
// ("/<token>/") set as <base href> so every relative asset link resolves under
// the token path the loopback server gates on.
templ Base(title, tokenBase string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<base href={ tokenBase }/>
			<link rel="stylesheet" href="assets/app.css"/>
			<script src="assets/htmx.min.js" defer></script>
			<script src="assets/htmx-ext-sse.min.js" defer></script>
			<script src="assets/alpine.min.js" defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

// Shell is the top-level app frame. For now it is a live log of the workspace
// event stream — the first end-to-end proof of the daemon → SSE → browser pipe.
// The session list, timeline, and inline artifacts land in later beads.
templ Shell(tokenBase string) {
	@Base("tend-ui", tokenBase) {
		<header class="titlebar">
			<span class="glyph">t</span>
			<span class="brand"><b>tend</b><span class="dim">-ui</span></span>
			<span class="mono sub">session console</span>
			<span class="conn"><span class="dot"></span> connected</span>
		</header>
		<main class="body">
			<div class="log-head">
				<span>Workspace activity</span>
				<span class="mono dim">workspace stream · live</span>
			</div>
			<div class="log-wrap" hx-ext="sse" sse-connect="events">
				<div id="log" class="log" sse-swap="ev" hx-swap="beforeend scroll:bottom">
					<div class="ev muted">waiting for workspace events…</div>
				</div>
			</div>
		</main>
	}
}

// EventLine renders one workspace event as an SSE-swapped log row.
templ EventLine(ev api.Event) {
	<div class="ev">
		<span class="ev-time mono">{ evTime(ev) }</span>
		<span class="ev-type">{ ev.Type }</span>
		if evRoot(ev) != "" {
			<span class="ev-wt mono">{ evRoot(ev) }</span>
		}
	</div>
}
